[Unit]
Description=Meridian read-only analytics dashboard
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/azizi/meridian/dashboard
Environment=DASHBOARD_HOST=127.0.0.1
Environment=DASHBOARD_PORT=4310
Environment=DASHBOARD_DB=/home/azizi/meridian/dashboard/data/analytics.sqlite
ExecStart=/home/azizi/.nvm/versions/node/v24.13.0/bin/node dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/azizi/meridian/dashboard/data
ProtectHome=read-only

[Install]
WantedBy=default.target
