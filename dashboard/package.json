{
  "name": "@meridian/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only analytics backend for Meridian plus the responsive analytics frontend. Ingests allowlisted runtime JSON/JSONL sources into SQLite, serves metric queries over a read-only Fastify API, and serves the built React frontend same-origin.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "migrate": "tsx src/scripts/migrate.ts",
    "backfill": "tsx src/scripts/backfill.ts",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --reporter=line",
    "typecheck:api": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "build": "npm run build:web && npm run build:api",
    "start": "node dist/index.js",
    "dash": "node scripts/dash.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "better-sqlite3": "^11.10.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "fastify": "^5.12.0",
    "kysely": "^0.29.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "latest",
    "happy-dom": "^20.11.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
